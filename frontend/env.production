# ========================================
# PRODUCTION ENVIRONMENT VARIABLES
# Easy Labour Platform - Frontend
# ========================================
# 
# INSTRUCTIONS FOR HOSTING:
# Copy these variables to your hosting platform's environment variables section
# (e.g., Vercel Environment Variables, Netlify Environment Variables, etc.)
#
# ========================================

# Backend API URL (Server-side)
# Used by Next.js API routes and server-side rendering
BACKEND_URL=https://easy-labour.onrender.com

# Backend API URL (Client-side)
# Used by client-side components (must start with NEXT_PUBLIC_)
NEXT_PUBLIC_BACKEND_URL=https://easy-labour.onrender.com

# Alternative API URL (for Google Auth)
NEXT_PUBLIC_API_URL=https://easy-labour.onrender.com

# Cookie Configuration
# Name of the authentication cookie
COOKIE_NAME=easy_token

# Node Environment
# Set to 'production' for hosting
NODE_ENV=production
